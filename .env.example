# Vercel AI Gateway key. Server only; never exposed to the browser.
AI_GATEWAY_API_KEY=
# Neon Postgres connection string (pooled).
DATABASE_URL=
# Shared access code typed by trainees. NOT real authentication.
ACCESS_CODE=
# Realtime voice model, as an AI Gateway model id.
REALTIME_MODEL=openai/gpt-realtime-2.1
# Text model that writes the debrief, as an AI Gateway model id.
# anthropic/claude-sonnet-5.5 was the best of those tried (see docs/spike-findings.md).
DEBRIEF_MODEL=anthropic/claude-sonnet-5.5
