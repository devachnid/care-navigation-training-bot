# Vercel AI Gateway key. Server only; never exposed to the browser.
AI_GATEWAY_API_KEY=
# Neon Postgres connection string (pooled).
DATABASE_URL=
# Needed once, for /setup (first run, while there are no users): at least 20 characters, or setup stays closed. Remove it after setup.
SETUP_CODE=
# Realtime voice model, as an AI Gateway model id.
REALTIME_MODEL=openai/gpt-realtime-2.1
# Text model that writes the debrief, as an AI Gateway model id.
# anthropic/claude-sonnet-5.5 was the best of those tried (see docs/engineering/voice-findings.md).
DEBRIEF_MODEL=anthropic/claude-sonnet-5.5
# Optional limits (defaults shown).
# MAX_CALL_SECONDS=600
# DAILY_CALL_LIMIT=25
